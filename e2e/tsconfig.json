{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types",
      "wdio-obsidian-service"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "wdio.conf.mts",
    "specs",
    "support"
  ]
}
