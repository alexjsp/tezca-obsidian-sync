#!/usr/bin/env bash
# Build and (re)start the Tezca server on Unraid. Env overrides: DEPLOY_HOST, DEPLOY_PATH,
# TEZCA_DATA, TEZCA_PORT, TEZCA_PUBLIC_URL (forwarded to compose).
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

DEPLOY_HOST="${DEPLOY_HOST:-root@unraid.jsp.scot}"
DEPLOY_PATH="${DEPLOY_PATH:-/mnt/user/appdata/tezca_source}"
TEZCA_DATA="${TEZCA_DATA:-/mnt/user/appdata/tezca}"
TEZCA_PORT="${TEZCA_PORT:-8089}"
TEZCA_PUBLIC_URL="${TEZCA_PUBLIC_URL:-https://tezca.jsp.scot}"
COMPOSE_FILE="deploy/compose.unraid.yml"
PROJECT="tezca"
RSYNC_RSH="${RSYNC_RSH:-ssh}"

SYNC_PATHS=(
  "./${COMPOSE_FILE}"
  "./deploy/Dockerfile"
  "./server/.dockerignore"
  "./server/go.mod"
  "./server/go.sum"
  "./server/cmd/"
  "./server/internal/"
)

echo "Deploying Tezca to ${DEPLOY_HOST}:${DEPLOY_PATH} (data ${TEZCA_DATA}, port ${TEZCA_PORT}, ${TEZCA_PUBLIC_URL})"

# The container runs as distroless nonroot (65532), so the bind-mounted data dir must be writable by it.
ssh "${DEPLOY_HOST}" "mkdir -p '${DEPLOY_PATH}' '${TEZCA_DATA}' && chown 65532:65532 '${TEZCA_DATA}'"

(
  cd "${ROOT_DIR}"
  rsync -az --delete --relative -e "${RSYNC_RSH}" "${SYNC_PATHS[@]}" "${DEPLOY_HOST}:${DEPLOY_PATH}/"
)

ssh "${DEPLOY_HOST}" "set -euo pipefail
cd '${DEPLOY_PATH}'
export TEZCA_DATA='${TEZCA_DATA}' TEZCA_PORT='${TEZCA_PORT}' TEZCA_PUBLIC_URL='${TEZCA_PUBLIC_URL}'
docker compose -p '${PROJECT}' -f '${COMPOSE_FILE}' build
docker compose -p '${PROJECT}' -f '${COMPOSE_FILE}' up -d
sleep 2
docker compose -p '${PROJECT}' -f '${COMPOSE_FILE}' ps
# Show the claim link if the server hasn't been claimed yet.
docker compose -p '${PROJECT}' -f '${COMPOSE_FILE}' logs --no-log-prefix tezca 2>&1 | grep -A1 'not claimed' | tail -2 || true"
